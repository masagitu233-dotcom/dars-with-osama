rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'osamanursamsil@gmail.com' ||
        request.auth.token.email == 'masagitu233@gmail.com'
      );
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instructorProfiles/{profileId} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 200 &&
        request.resource.data.role is string &&
        request.resource.data.role.size() >= 2 &&
        request.resource.data.role.size() <= 200 &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 2 &&
        request.resource.data.title.size() <= 300;
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /sessions/{sessionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if (isSignedIn() && request.auth.uid == userId && (request.resource.data.role == resource.data.role || isAdmin())) || isAdmin();
      allow delete: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /quizAttempts/{attemptId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // CONSULTATIONS SECURITY RULES (RUANG KONSULTASI)
    match /consultations/{consultationId} {
      // 1. Read: Admin OR Student Owner OR Public approved Q&A ('learning' & isPublished == true)
      allow read: if isAdmin() || 
        (isSignedIn() && resource.data.studentId == request.auth.uid) || 
        (resource.data.category == 'learning' && resource.data.isPublished == true);

      // 2. Create: Authenticated student creating for self with status == 'pending' and isPublished == false
      allow create: if isSignedIn() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.isPublished == false &&
        (request.resource.data.category == 'learning' || request.resource.data.category == 'private');

      // 3. Update:
      // - Admin can update, reply, change status, toggle isPublished
      //   (SAFETY: 'private' category CAN NEVER be set to isPublished == true)
      // - Student can update status or student follow-up
      allow update: if (isAdmin() && (
        request.resource.data.category != 'private' || request.resource.data.isPublished == false
      )) || (
        isSignedIn() && 
        resource.data.studentId == request.auth.uid &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.category == resource.data.category &&
        request.resource.data.isPublished == false
      );

      // 4. Delete: Admin only
      allow delete: if isAdmin();
    }

    // ARTICLE COMMENTS (KOMENTAR PEMBACA ARTIKEL)
    match /articleComments/{commentId} {
      // 1. Read: Admin can read all comments; Public can only read approved comments
      allow read: if isAdmin() || resource.data.status == 'approved';

      // 2. Create: Anyone can submit a comment, but:
      //    - status MUST be 'pending' (cannot self-approve)
      //    - authorName, content, articleId must be non-empty and bounded
      allow create: if request.resource.data.status == 'pending' &&
        request.resource.data.authorName is string &&
        request.resource.data.authorName.size() >= 2 &&
        request.resource.data.authorName.size() <= 100 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() >= 5 &&
        request.resource.data.content.size() <= 1000 &&
        request.resource.data.articleId is string &&
        request.resource.data.articleId.size() > 0 &&
        request.resource.data.articleId.size() <= 128;

      // 3. Update & Delete: Admin only (for moderating status or deleting comments)
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
