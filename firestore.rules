rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == '4CtrjjINKvPjAFbXlpmem8SfS403' ||
        ('email' in request.auth.token && (
          request.auth.token.email.lower() == 'osamanursamsil@gmail.com' ||
          request.auth.token.email.lower() == 'masagitu233@gmail.com'
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instructorProfiles/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /sessions/{sessionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if (isSignedIn() && request.auth.uid == userId && (!('role' in resource.data) || request.resource.data.role == resource.data.role || isAdmin())) || isAdmin();
      allow delete: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /quizAttempts/{attemptId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // CONSULTATIONS SECURITY RULES (RUANG KONSULTASI)
    match /consultations/{consultationId} {
      // 1. Kueri Koleksi (list):
      // - Pengunjung publik (anonim & siswa) diizinkan membaca dokumen dengan filter where('isPublished', '==', true)
      // - Siswa terautentikasi dapat menjalankan kueri where('studentId', '==', request.auth.uid) untuk konsultasi pribadinya
      // - Admin dapat membaca seluruh kueri konsultasi
      allow list: if (resource.data.isPublished == true) ||
        (isSignedIn() && resource.data.studentId == request.auth.uid) ||
        isAdmin();

      // 2. Pembacaan Dokumen Tunggal (get):
      // - Publik dapat membaca dokumen apa saja yang berstatus isPublished == true
      // - Siswa pemilik dokumen dapat membaca konsultasi privat miliknya
      // - Admin dapat membaca dokumen konsultasi apa pun
      allow get: if (resource.data.isPublished == true) ||
        (isSignedIn() && resource.data.studentId == request.auth.uid) ||
        isAdmin();

      // 3. Create: Authenticated student creating for self with status == 'pending' and isPublished == false
      //    Supports optional whatsappNumber (max 50 chars)
      allow create: if isSignedIn() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.isPublished == false &&
        (request.resource.data.category == 'learning' || request.resource.data.category == 'private') &&
        (!('whatsappNumber' in request.resource.data) || 
         request.resource.data.whatsappNumber == null || 
         (request.resource.data.whatsappNumber is string && request.resource.data.whatsappNumber.size() <= 50));

      // 4. Update:
      // - Admin can update, reply, change status, toggle isPublished (including private consultations)
      // - Student can update own consultation without changing category or publishing
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.studentId == request.auth.uid &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.category == resource.data.category &&
        request.resource.data.isPublished == false
      );

      // 5. Delete: Admin OR Student Owner
      allow delete: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);

      // 6. Followups Subcollection (Rangkaian Diskusi Lanjutan)
      match /followups/{followupId} {
        allow get, list: if (get(/databases/$(database)/documents/consultations/$(consultationId)).data.isPublished == true) ||
          (isSignedIn() && get(/databases/$(database)/documents/consultations/$(consultationId)).data.studentId == request.auth.uid) ||
          isAdmin();

        allow create: if (isSignedIn() &&
          request.resource.data.studentId == request.auth.uid &&
          request.resource.data.studentId == get(/databases/$(database)/documents/consultations/$(consultationId)).data.studentId &&
          request.resource.data.content is string &&
          request.resource.data.content.size() >= 5 &&
          request.resource.data.content.size() <= 5000) || isAdmin();

        allow update: if isAdmin();

        allow delete: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/consultations/$(consultationId)).data.studentId == request.auth.uid);
      }
    }

    // ARTICLE COMMENTS (KOMENTAR PEMBACA ARTIKEL)
    match /articleComments/{commentId} {
      // 1. Read: Admin can read all comments; Public can only read approved comments
      allow read: if isAdmin() || resource.data.status == 'approved';

      // 2. Create: User comment (status == 'pending') OR Admin reply (isAdmin() with status == 'approved')
      allow create: if (
        request.resource.data.status == 'pending' &&
        request.resource.data.authorName is string &&
        request.resource.data.authorName.size() >= 2 &&
        request.resource.data.authorName.size() <= 100 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() >= 5 &&
        request.resource.data.content.size() <= 1000 &&
        request.resource.data.articleId is string &&
        request.resource.data.articleId.size() > 0 &&
        request.resource.data.articleId.size() <= 128
      ) || isAdmin();

      // 3. Update: Admin only
      allow update: if isAdmin();

      // 4. Delete: Admin OR comment author OR parent comment author
      allow delete: if isAdmin() ||
        (isSignedIn() && 'userId' in resource.data && resource.data.userId == request.auth.uid) ||
        (isSignedIn() && 'parentCommentId' in resource.data && resource.data.parentCommentId != null && 
         get(/databases/$(database)/documents/articleComments/$(resource.data.parentCommentId)).data.userId == request.auth.uid);
    }

    // EMAIL NOTIFICATIONS & AUDIT LOGS
    match /emailNotifications/{notificationId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // SYSTEM NOTIFICATION SETTINGS
    match /notificationSettings/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
